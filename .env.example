# Demo-only credentials; use the address of an independently managed RabbitMQ.
PORT=3001
RABBITMQ_URL=amqp://tournament:tournament@localhost:5672
# Address of the same external broker from the producer container.
RABBITMQ_DOCKER_URL=amqp://tournament:tournament@host.docker.internal:5672
PUBLISH_TIMEOUT_MS=5000
LOG_LEVEL=info
TOURNAMENT_URL=http://localhost:3000
TOURNAMENT_OPENAPI_URL=http://localhost:3000/openapi.json
PRODUCER_URL=http://localhost:3001

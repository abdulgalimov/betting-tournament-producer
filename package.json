{
  "name": "test-producer",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rspack build --config rspack.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm typecheck && pnpm client:check && pnpm lint && pnpm format:check",
    "client:generate": "node --env-file-if-exists=.env --import tsx scripts/generate-tournament-client.ts",
    "client:check": "node --import tsx scripts/generate-tournament-client.ts --check",
    "leaderboard": "node --env-file-if-exists=.env --import tsx scripts/leaderboard.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.4.0",
    "nestjs-pino": "5.3.2",
    "openapi-fetch": "0.17.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rspack/cli": "2.3.3",
    "@rspack/core": "2.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "webpack-node-externals": "3.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12 <13"
  }
}
